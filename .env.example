# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CHANNEL_ID=your_channel_id_here

# Web Server Configuration
PORT=3000

# --- XP / Leveling (all optional; sensible defaults are used if omitted) ---
# XP awarded per chat message (random between min and max).
XP_PER_MESSAGE_MIN=15
XP_PER_MESSAGE_MAX=25
# Anti-spam: only award message XP once per this many seconds per user.
XP_MESSAGE_COOLDOWN_SEC=60
# XP awarded per minute spent actively in a voice channel.
XP_PER_VOICE_MINUTE=10
# Announce level-ups in chat ("true"/"false").
LEVEL_UP_ANNOUNCE=true
# Comma-separated user IDs allowed to reset XP even without Administrator.
# Put harish696's Discord user ID here, e.g. XP_RESET_USER_IDS=123456789012345678
XP_RESET_USER_IDS=
